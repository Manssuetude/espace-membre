# ENVIRONMENT: "development" (DB locale) ou "production" (Supabase)
ENVIRONMENT=development

# --- Base de données locale (ENVIRONMENT=development) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=manssu_local

# --- Base de données production / Supabase (ENVIRONMENT=production) ---
DB_USER=postgres.your-project-ref
DB_PASSWORD=
SUPABASE_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# --- Auth JWT ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Manssuétude

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://membre.manssuetude.com,https://membres.manssuetude.com
CORS_ALLOW_LOCAL_NETWORK=true

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRATION=3600

# --- Divers ---
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_PLACES_API_KEY=
